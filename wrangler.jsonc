{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bsky-mutual-blocks",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-28",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/client-metadata.json"],
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
